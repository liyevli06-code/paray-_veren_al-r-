rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.qpWins is int && request.resource.data.qpGames is int
        && request.resource.data.qpWins <= request.resource.data.qpGames;
    }
  }
}
